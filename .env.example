# انسخ الملف ده باسم .env وحط المفاتيح. متعملش commit لـ .env أبدًا (الملف ده نفسه بيترفع، فمتحطش فيه مفاتيح).

# --- مقاطع الطبيعة
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Buffer (يوتيوب + تيك توك + إنستجرام) — Settings → API
BUFFER_API_KEY=

# --- Cloudinary (استضافة الفيديو لحد ما Buffer ينشره) — Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
# أو بدل التلاتة: انسخ "API environment variable" من Cloudinary (بيبدأ بـ cloudinary://)
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- فيسبوك (Meta Graph API) — الصفحة والتوكن بيتملوا تلقائي بـ tools/fb_token.py
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- تنبيهات لما حاجة تفشل (اختياري — واحد منهم يكفي)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
